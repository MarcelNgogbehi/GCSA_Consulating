# ─────────────────────────────────────────────────────────────
#  GCSA Consulting — Environment variable TEMPLATE
#  Copy this file to ".env" and fill in real values.
#  The real ".env" is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ── Public (exposed to the browser — never put secrets here) ──
NEXT_PUBLIC_CURRENCY='£'
# Dev: http://localhost:3000   Prod: https://www.gcsaconsulting.co.uk
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# ── Database (Prisma Postgres / any PostgreSQL) ──
DATABASE_URL='postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require'

# ── Resend (transactional email) ──
# Training registration takes no online payment: the form captures the lead to
# the database and emails EMAIL_TO + REGISTRATIONS_EMAIL_TO.
RESEND_API_KEY=''
# MUST be an address on a Resend-verified domain. The onboarding@resend.dev
# sandbox sender only delivers to the Resend account owner — never use it here.
EMAIL_FROM='GCSA Consulting <noreply@gcsaconsulting.co.uk>'
# Internal inbox for contact / subscribe / registration notifications
EMAIL_TO='info@gcsaconsulting.co.uk'
# Dedicated inbox for training registrations (copied alongside EMAIL_TO)
REGISTRATIONS_EMAIL_TO='mngogbehei@yahoo.com'

# ── Admin portal (/admin) ──
ADMIN_EMAIL='admin@gcsaconsulting.co.uk'
ADMIN_PASSWORD='set-a-strong-password'
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=''
